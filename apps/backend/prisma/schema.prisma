// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  // Prisma 7's modern generator. The client is written into src/ as ordinary
  // generated source instead of being injected into node_modules, so it
  // survives dependency pruning and multi-stage Docker copies.
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  user
  admin

  @@map("user_role")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @db.VarChar(255)
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?  @db.VarChar(45)
  userAgent String?  @db.Text
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  issuer                String?
  password              String?   @db.Text
  createdAt             DateTime
  updatedAt             DateTime

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

model User {
  id                         String                      @id
  name                       String
  email                      String
  emailVerified              Boolean
  image                      String?                     @db.Text
  createdAt                  DateTime
  updatedAt                  DateTime
  sessions                   Session[]
  accounts                   Account[]
  role                       UserRole                    @default(user)
  accommodationManualValues  AccommodationManualValue[]
  accommodationInterventions AccommodationIntervention[]
  accommodationRuns          AccommodationRun[]

  username        String? @db.VarChar(50)
  displayUsername String? @db.VarChar(50)

  organizationMemberships OrganizationMember[]
  ownedOrganizations      Organization[]       @relation("OrganizationOwner")
  recordedPayments        Payment[]

  @@unique([email])
  @@unique([username])
  @@map("user")
}

// akc.io domain model. Design, constraints and sources of truth:
// docs/architecture/data-model.md. CHECK and EXCLUDE constraints and the
// variable-symbol sequence are not expressible in Prisma; they live in the
// migration SQL and are covered by src/**/*.db-spec.ts.

// ─── Organizations & tenancy ────────────────────────────────────────────────

enum OrganizationRole {
  owner

  @@map("organization_role")
}

model Organization {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String   @db.VarChar(200)
  // Creator and owner. Together with the lower-cased, trimmed name it is unique
  // (hand-written index in the migration, S2-02).
  ownerId   String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  owner         User                 @relation("OrganizationOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members       OrganizationMember[]
  events        Event[]
  registrations Registration[]
  payments      Payment[]

  @@index([ownerId])
  @@map("organization")
}

model OrganizationMember {
  organizationId String           @db.Uuid
  userId         String
  role           OrganizationRole @default(owner)
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([organizationId, userId])
  @@index([userId])
  @@map("organization_member")
}

// ─── Events, terms, accommodation ───────────────────────────────────────────

enum EventStatus {
  draft
  open
  closed

  @@map("event_status")
}

model Event {
  id             String      @id @default(uuid(7)) @db.Uuid
  organizationId String      @db.Uuid
  publicId       String      @unique @db.VarChar(16)
  name           String      @db.VarChar(200)
  description    String      @db.Text
  location       String      @db.VarChar(300)
  status         EventStatus @default(draft)
  firstOpenedAt  DateTime?   @db.Timestamptz(3)
  // Listing in the public catalog; independent of the registration status.
  isPublished    Boolean     @default(false)

  bankAccountPrefix   String? @db.VarChar(6)
  bankAccountNumber   String? @db.VarChar(10)
  bankCode            String? @db.Char(4)
  paymentReminderDays Int?
  // Days before a term's start from which registration changes need approval (F35-1a); null = never.
  changeApprovalDays  Int?

  // Public presentation on the catalog detail (F55). Never the account's own contact.
  conditions   String  @default("") @db.Text
  contactName  String? @db.VarChar(200)
  contactEmail String? @db.VarChar(320)
  contactPhone String? @db.VarChar(20)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  organization               Organization                @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  terms                      EventTerm[]
  rooms                      Room[]
  roomAvailabilities         RoomTermAvailability[]
  registrations              Registration[]
  registrationTerms          RegistrationTerm[]
  accommodationRules         AccommodationRules?
  accommodationRuns          AccommodationRun[]
  accommodationInterventions AccommodationIntervention[]
  programmeItems             ProgrammeItem[]
  photos                     EventPhoto[]

  @@unique([id, organizationId])
  @@index([organizationId, createdAt])
  @@map("event")
}

// A photo of the public presentation (F55); the bytes live in object storage
// under `objectKey`.
model EventPhoto {
  id          String   @id @default(uuid(7)) @db.Uuid
  eventId     String   @db.Uuid
  objectKey   String   @unique @db.VarChar(200)
  contentType String   @db.VarChar(50)
  byteSize    Int
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  event Event @relation(fields: [eventId], references: [id], onDelete: Restrict)

  @@index([eventId, createdAt])
  @@map("event_photo")
}

model EventTerm {
  id         String   @id @default(uuid(7)) @db.Uuid
  eventId    String   @db.Uuid
  label      String   @db.VarChar(100)
  startDate  DateTime @db.Date
  endDate    DateTime @db.Date
  priceMinor Int
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  event                      Event                       @relation(fields: [eventId], references: [id], onDelete: Restrict)
  roomAvailabilities         RoomTermAvailability[]
  registrationTerms          RegistrationTerm[]
  accommodationOrder         AccommodationTermOrder?
  accommodationRuns          AccommodationRun[]
  accommodationInterventions AccommodationIntervention[]
  programmeItems             ProgrammeItem[]

  @@unique([id, eventId])
  @@index([eventId, startDate])
  @@map("event_term")
}

model Room {
  id        String   @id @default(uuid(7)) @db.Uuid
  eventId   String   @db.Uuid
  // Trimmed, and unique per event ignoring case (hand-written index in the
  // migration, S2-05).
  label     String   @db.VarChar(100)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  event          Event                  @relation(fields: [eventId], references: [id], onDelete: Restrict)
  availabilities RoomTermAvailability[]

  @@unique([id, eventId])
  @@map("room")
}

// A room's settings in one term (F11-1). The beds are kept while the room is
// unavailable; only an available room adds places to the term's capacity.
model RoomTermAvailability {
  roomId      String  @db.Uuid
  termId      String  @db.Uuid
  eventId     String  @db.Uuid
  isAvailable Boolean @default(true)
  baseBeds    Int
  extraBeds   Int     @default(0)

  room  Room      @relation(fields: [roomId, eventId], references: [id, eventId], onDelete: Cascade)
  term  EventTerm @relation(fields: [termId, eventId], references: [id, eventId], onDelete: Cascade)
  event Event     @relation(fields: [eventId], references: [id], onDelete: Restrict)

  @@id([roomId, termId])
  @@index([termId])
  @@map("room_term_availability")
}

// One item of a term's programme (F65). Start is Europe/Prague wall-clock
// time, so a date and an `HH:mm` string; the date lies within the term
// (checked by the service, as terms are editable until registration opens).
model ProgrammeItem {
  id          String   @id @default(uuid(7)) @db.Uuid
  eventId     String   @db.Uuid
  termId      String   @db.Uuid
  title       String   @db.VarChar(200)
  startDate   DateTime @db.Date
  startTime   String   @db.VarChar(5)
  place       String?  @db.VarChar(200)
  description String?  @db.VarChar(1000)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  term  EventTerm @relation(fields: [termId, eventId], references: [id, eventId], onDelete: Cascade)
  event Event     @relation(fields: [eventId], references: [id], onDelete: Restrict)

  @@index([termId, startDate, startTime])
  @@map("programme_item")
}

// ─── Participants & access ──────────────────────────────────────────────────

model ParticipantAccount {
  id        String   @id @default(uuid(7)) @db.Uuid
  email     String   @unique @db.VarChar(320) // normalized: trimmed + lower-case
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  registrations Registration[]
  magicLinks    ParticipantMagicLink[]
  sessions      ParticipantSession[]
  emails        EmailDelivery[]

  @@map("participant_account")
}

model ParticipantMagicLink {
  id                   String    @id @default(uuid(7)) @db.Uuid
  participantAccountId String    @db.Uuid
  tokenHash            String    @unique @db.Char(64) // SHA-256 hex
  expiresAt            DateTime  @db.Timestamptz(3)
  consumedAt           DateTime? @db.Timestamptz(3)
  createdAt            DateTime  @default(now()) @db.Timestamptz(3)

  participantAccount ParticipantAccount @relation(fields: [participantAccountId], references: [id], onDelete: Cascade)

  @@index([participantAccountId, createdAt])
  @@map("participant_magic_link")
}

model ParticipantSession {
  id                   String    @id @default(uuid(7)) @db.Uuid
  participantAccountId String    @db.Uuid
  tokenHash            String    @unique @db.Char(64)
  expiresAt            DateTime  @db.Timestamptz(3)
  revokedAt            DateTime? @db.Timestamptz(3)
  createdAt            DateTime  @default(now()) @db.Timestamptz(3)

  participantAccount ParticipantAccount @relation(fields: [participantAccountId], references: [id], onDelete: Cascade)

  @@index([participantAccountId])
  @@map("participant_session")
}

// ─── Registrations ──────────────────────────────────────────────────────────

enum ParticipationStatus {
  confirmed
  waitlisted
  // Released by the participant (F35-2a); the row stays as history and holds no bed.
  cancelled

  @@map("participation_status")
}

// The participant's own answer (F64); `other`, `undisclosed` and no answer
// leave the accommodation to the organizer.
enum Gender {
  female
  male
  other
  undisclosed

  @@map("gender")
}

model Registration {
  id                   String @id @default(uuid(7)) @db.Uuid
  organizationId       String @db.Uuid
  eventId              String @db.Uuid
  participantAccountId String @db.Uuid
  submissionKey        String @unique @db.Uuid
  payloadHash          String @db.Char(64) // SHA-256 hex of the normalized submission (§3.7)
  variableSymbol       String @unique @default(dbgenerated("(nextval('registration_variable_symbol_seq'::regclass))::text")) @db.VarChar(10)
  // Unguessable capability of the QR payment link (F21-1): it allows paying this registration and nothing else.
  paymentToken         String @unique @default(dbgenerated("replace((gen_random_uuid())::text || (gen_random_uuid())::text, '-', '')")) @db.VarChar(64)

  firstName   String  @db.VarChar(100)
  lastName    String  @db.VarChar(100)
  email       String  @db.VarChar(320) // as submitted
  phone       String  @db.VarChar(16) // E.164
  // Voluntary answer for accommodation (F64), per registration, never the
  // account identity. Null is "not answered", distinct from `undisclosed`.
  gender      Gender?
  // The participant's own words for `other`; null for every other answer
  // (CHECK in the migration).
  genderOther String? @db.VarChar(100)

  receivedAt        DateTime  @default(now()) @db.Timestamptz(3)
  paymentReminderAt DateTime? @db.Timestamptz(3)
  // Bumped by every executed change (F35-2a); a proposal made on an older one is stale.
  version           Int       @default(0)

  // snapshot of event payment settings at receipt; all null for an event
  // whose terms were all free when it opened (CHECK in the migration)
  bankAccountPrefix   String? @db.VarChar(6)
  bankAccountNumber   String? @db.VarChar(10)
  bankCode            String? @db.Char(4)
  paymentReminderDays Int?

  organization               Organization                @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  event                      Event                       @relation(fields: [eventId, organizationId], references: [id, organizationId], onDelete: Restrict)
  participantAccount         ParticipantAccount          @relation(fields: [participantAccountId], references: [id], onDelete: Restrict)
  terms                      RegistrationTerm[]
  payments                   Payment[]
  emails                     EmailDelivery[]
  changes                    RegistrationChange[]
  accommodationManualValue   AccommodationManualValue?
  accommodationInterventions AccommodationIntervention[]

  @@unique([eventId, participantAccountId])
  @@unique([id, eventId])
  @@unique([id, organizationId])
  @@index([eventId, receivedAt])
  @@index([participantAccountId])
  @@map("registration")
}

model RegistrationTerm {
  registrationId String              @db.Uuid
  termId         String              @db.Uuid
  eventId        String              @db.Uuid
  status         ParticipationStatus
  priceMinor     Int
  decidedAt      DateTime            @db.Timestamptz(3)

  registration Registration @relation(fields: [registrationId, eventId], references: [id, eventId], onDelete: Restrict)
  term         EventTerm    @relation(fields: [termId, eventId], references: [id, eventId], onDelete: Restrict)
  event        Event        @relation(fields: [eventId], references: [id], onDelete: Restrict)

  @@id([registrationId, termId])
  @@index([termId, status])
  @@map("registration_term")
}

// A participant's change of an own registration (F35-2a): executed at once
// (`applied`) or waiting for the organizer. At most one is pending per
// registration (partial unique index in the migration).
enum RegistrationChangeStatus {
  pending
  applied
  approved
  rejected

  @@map("registration_change_status")
}

model RegistrationChange {
  id             String                   @id @default(uuid(7)) @db.Uuid
  registrationId String                   @db.Uuid
  eventId        String                   @db.Uuid
  status         RegistrationChangeStatus
  // What the participant proposed: names, phone, term moves and cancellations.
  proposal       Json
  // Original and proposed values as shown to both sides; frozen once decided.
  summary        Json
  createdAt      DateTime                 @default(now()) @db.Timestamptz(3)
  decidedAt      DateTime?                @db.Timestamptz(3)

  registration Registration @relation(fields: [registrationId, eventId], references: [id, eventId], onDelete: Restrict)

  @@index([registrationId, createdAt])
  @@index([eventId, status, createdAt])
  @@map("registration_change")
}

// ─── Payments ───────────────────────────────────────────────────────────────

enum PaymentSource {
  organizer
  qr_link

  @@map("payment_source")
}

model Payment {
  id             String        @id @default(uuid(7)) @db.Uuid
  organizationId String        @db.Uuid
  registrationId String        @db.Uuid
  submissionKey  String        @unique @db.Uuid
  amountMinor    Int
  receivedOn     DateTime      @db.Date
  source         PaymentSource @default(organizer)
  recordedById   String? // set for organizer entries only, null for a QR link payment
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  registration Registration @relation(fields: [registrationId, organizationId], references: [id, organizationId], onDelete: Restrict)
  recordedBy   User?        @relation(fields: [recordedById], references: [id], onDelete: Restrict)

  @@index([registrationId])
  @@map("payment")
}

// ─── Outbound e-mail log ────────────────────────────────────────────────────

enum EmailType {
  registration_confirmation
  participant_magic_link

  @@map("email_type")
}

enum EmailDeliveryStatus {
  pending
  accepted
  failed

  @@map("email_delivery_status")
}

model EmailDelivery {
  id                   String              @id @default(uuid(7)) @db.Uuid
  type                 EmailType
  status               EmailDeliveryStatus @default(pending)
  recipientEmail       String              @db.VarChar(320)
  registrationId       String?             @db.Uuid
  participantAccountId String?             @db.Uuid
  providerMessageId    String?             @db.VarChar(100)
  errorMessage         String?             @db.VarChar(1000) // sanitized, never contains tokens
  createdAt            DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime            @updatedAt @db.Timestamptz(3)

  registration       Registration?       @relation(fields: [registrationId], references: [id], onDelete: Restrict)
  participantAccount ParticipantAccount? @relation(fields: [participantAccountId], references: [id], onDelete: Restrict)

  @@index([registrationId])
  @@index([status, createdAt])
  @@map("email_delivery")
}

// ─── Accommodation evaluation (S3-T3 spec v4 §9, S3-T4) ─────────────────────

// Pravidla ubytování of an event (§2). No row: no hard attribute, no soft rules.
model AccommodationRules {
  eventId              String   @id @db.Uuid
  // The categorical question that splits rooms; null when none does.
  hardAttribute        String?  @db.VarChar(64)
  // Answers of the hard attribute that do not determine a room.
  nonDeterminingValues String[] @default([]) @db.VarChar(100)
  // Ranked soft attributes, most important first (phase 2).
  softAttributes       String[] @default([]) @db.VarChar(64)
  updatedAt            DateTime @updatedAt @db.Timestamptz(3)

  event Event @relation(fields: [eventId], references: [id], onDelete: Restrict)

  @@map("accommodation_rules")
}

// The organizer's determination of the effective value (§4), for every term
// of the registration. Valid only while the answer equals `basedOnAnswer`.
model AccommodationManualValue {
  registrationId String   @id @db.Uuid
  eventId        String   @db.Uuid
  value          String   @db.VarChar(100)
  basedOnAnswer  String?  @db.VarChar(100)
  reason         String   @db.VarChar(500)
  createdById    String
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  registration Registration @relation(fields: [registrationId, eventId], references: [id, eventId], onDelete: Restrict)
  createdBy    User         @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([registrationId, eventId])
  @@index([eventId])
  @@map("accommodation_manual_value")
}

// A manually changed order of a term (§6, F39-1). No row: order by receipt.
model AccommodationTermOrder {
  termId          String   @id @db.Uuid
  eventId         String   @db.Uuid
  registrationIds String[] @db.Uuid
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  term EventTerm @relation(fields: [termId, eventId], references: [id, eventId], onDelete: Cascade)

  @@unique([termId, eventId])
  @@map("accommodation_term_order")
}

enum AccommodationInterventionKind {
  position
  manual_value

  @@map("accommodation_intervention_kind")
}

// Immutable record of a manual intervention (§6, F39-1): who, when, whom,
// before and after, and why.
model AccommodationIntervention {
  id             String                        @id @default(uuid(7)) @db.Uuid
  eventId        String                        @db.Uuid
  // The term of a position change; null for a determination (all terms).
  termId         String?                       @db.Uuid
  registrationId String                        @db.Uuid
  kind           AccommodationInterventionKind
  actorId        String
  reason         String                        @db.VarChar(500)
  before         Json
  after          Json
  createdAt      DateTime                      @default(now()) @db.Timestamptz(3)

  event        Event        @relation(fields: [eventId], references: [id], onDelete: Restrict)
  // The term of a position change belongs to the same event.
  term         EventTerm?   @relation(fields: [termId, eventId], references: [id, eventId], onDelete: Restrict)
  registration Registration @relation(fields: [registrationId, eventId], references: [id, eventId], onDelete: Restrict)
  actor        User         @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([eventId, createdAt])
  @@map("accommodation_intervention")
}

enum AccommodationRunStatus {
  solved
  infeasible
  timeout
  failed

  @@map("accommodation_run_status")
}

// Immutable evaluation of one term (§5, §9): the snapshot of its inputs, the
// order used, and the proposal. A confirmation will point to the run it used.
model AccommodationRun {
  id            String                 @id @default(uuid(7)) @db.Uuid
  eventId       String                 @db.Uuid
  termId        String                 @db.Uuid
  status        AccommodationRunStatus
  // Null when the system started it.
  triggeredById String?
  solverVersion String                 @db.VarChar(64)
  input         Json
  // The proposal; null for a failed run.
  result        Json?
  error         String?                @db.Text
  startedAt     DateTime               @db.Timestamptz(3)
  finishedAt    DateTime               @db.Timestamptz(3)

  event       Event     @relation(fields: [eventId], references: [id], onDelete: Restrict)
  term        EventTerm @relation(fields: [termId, eventId], references: [id, eventId], onDelete: Restrict)
  triggeredBy User?     @relation(fields: [triggeredById], references: [id], onDelete: Restrict)

  @@index([termId, startedAt])
  @@map("accommodation_run")
}
