# Basic Auth Configuration
BETTER_AUTH_SECRET=development_secret_key_change_in_production
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=adminpassword

# Environment Configuration
NODE_ENV=development

# URLs
BACKEND_URL=http://localhost:4050
FRONTEND_URL=http://localhost:3050
FRONTEND_RESET_PASSWORD_ROUTE=reset-password

# Database Configuration
DATABASE_URL=postgresql://akcio:akcio@localhost:5433/akcio

# Server Configuration
PORT=4050

# Mail Configuration
# Set SMTP_HOST, SMTP_USERNAME and SMTP_PASSWORD to send via SMTP; otherwise
# ConsoleMailerAdapter logs emails (dev).
# Gmail: enable 2-Step Verification, then create an App Password.
SMTP_HOST=smtp.gmail.com
SMTP_SECURE=true
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
# Optional sender, e.g. "akc.io <you@gmail.com>" (defaults to SMTP_USERNAME).
EMAIL_FROM=
